// Prisma Schema for Shagun Tracker (SQLite for zero-config local run)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────
// User & Authentication
// ──────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  events   Event[]
  guests   Guest[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ──────────────────────────────────────────
// Events (Weddings, Engagements, etc.)
// ──────────────────────────────────────────

model Event {
  id         String   @id @default(cuid())
  userId     String
  title      String
  eventType  String   @default("WEDDING")
  eventDate  DateTime
  venue      String?
  city       String?
  notes      String?
  coverImage String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  gifts Gift[]

  @@index([userId])
  @@map("events")
}

// ──────────────────────────────────────────
// Guests (Relatives, Friends, etc.)
// ──────────────────────────────────────────

model Guest {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String?
  email     String?
  address   String?
  city      String?
  relation  String?
  side      String   @default("GROOM")
  photoUrl  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  gifts           Gift[]
  reciprocityFrom Reciprocity[] @relation("OriginalGuest")

  @@index([userId])
  @@index([name])
  @@map("guests")
}

// ──────────────────────────────────────────
// Gifts (Cash & Items)
// ──────────────────────────────────────────

model Gift {
  id              String   @id @default(cuid())
  eventId         String
  guestId         String
  giftType        String   @default("CASH")
  cashAmount      Float?
  currency        String   @default("INR")
  cashBreakdown   String?  // JSON string
  giftDescription String?
  giftImageUrl    String?
  envelopeStyle   String   @default("CLASSIC_RED")
  isOpened        Boolean  @default(false)
  voiceTranscript String?
  receivedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest       Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  reciprocity Reciprocity? @relation("OriginalGift")

  @@index([eventId])
  @@index([guestId])
  @@index([giftType])
  @@map("gifts")
}

// ──────────────────────────────────────────
// Reciprocity Tracking
// ──────────────────────────────────────────

model Reciprocity {
  id              String    @id @default(cuid())
  originalGiftId  String    @unique
  guestId         String
  suggestedAmount Float?
  actualAmount    Float?
  status          String    @default("PENDING")
  dueByDate       DateTime?
  returnEventName String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  originalGift Gift  @relation("OriginalGift", fields: [originalGiftId], references: [id], onDelete: Cascade)
  guest        Guest @relation("OriginalGuest", fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId])
  @@index([status])
  @@map("reciprocity")
}


// ──────────────────────────────────────────
// Wedding Gift Registry / Wishlist (शादी उपहार सूची)
// ──────────────────────────────────────────

model WeddingGiftItem {
  id             String   @id @default(cuid())
  userId         String?
  title          String
  category       String   @default("Home")
  suggestedStore String?
  storeUrl       String?
  approxCost     Float?
  claimedBy      String?
  claimedByPhone String?
  status         String   @default("AVAILABLE") // "AVAILABLE" or "CLAIMED"
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("wedding_gift_items")
}
